---
// 하위 페이지 머리말. 페이지당 h1 하나.
interface Props {
  kicker: string;
  title: string[];
  copy?: string;
}
const { kicker, title, copy } = Astro.props;
---

<section class="intro">
  <div class="container">
    <p class="kicker">{kicker}</p>
    <h1>{title.map((line, i) => (<>{i > 0 && <br />}{line}</>))}</h1>
    {copy && <p class="copy">{copy}</p>}
  </div>
</section>

<style>
  .intro {
    padding-block: clamp(2.25rem, 1.6rem + 2.5vw, 3.75rem) clamp(1rem, 0.6rem + 1.5vw, 1.75rem);
    background: linear-gradient(180deg, var(--color-surface) 40%, var(--color-tint));
  }
  .kicker {
    margin-bottom: 18px;
    font-size: var(--text-micro);
    font-weight: 600;
    letter-spacing: 1.5px;
    color: var(--color-accent);
  }
  h1 {
    font-size: clamp(1.875rem, 1.5rem + 1.6vw, 2.5rem);
    line-height: 1.3;
    letter-spacing: -1.8px;
  }
  .copy {
    max-width: var(--text-max);
    margin-top: 16px;
    color: var(--color-text-2);
  }
</style>
