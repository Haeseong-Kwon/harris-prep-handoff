---
// ConcernDiagnosis: 4개 고민 단일 선택 → 답변 + 맞춤 상담 링크(/contact?concern=n).
// 선택만으로 접수·외부 요청이 일어나지 않는다.
import { concerns } from '../data/site';
import Section from './Section.astro';
---

<Section
  id="diagnosis"
  eyebrow="YOUR CHILD, YOUR QUESTION"
  title={['우리 아이 영어,', '어디에서 멈춰 있나요?']}
  copy={['우리 아이에게 맞는 과정인지, 고민부터 짚어보세요.']}
>
  <div data-diagnosis>
    <div class="tiles" role="group" aria-label="자녀 영어 고민 선택">
      {concerns.map((c) => (
        <button type="button" class="tile" data-concern={c.id} aria-pressed="false">
          <span class="no" aria-hidden="true">Q{c.id + 1}</span>
          <span>{c.lines[0]}<br />{c.lines[1]}</span>
        </button>
      ))}
    </div>
    <div aria-live="polite">
      <div class="answer" data-answer hidden>
        <p data-answer-text></p>
        <div class="actions">
          <a class="btn" href="/contact" data-fit-cta>우리 아이 과정 상담</a>
        </div>
      </div>
    </div>
  </div>
</Section>

<script>
  import { concerns } from '../data/site';

  const root = document.querySelector<HTMLElement>('[data-diagnosis]');
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-concern]')];
    const answer = root.querySelector<HTMLElement>('[data-answer]')!;
    const answerText = root.querySelector<HTMLElement>('[data-answer-text]')!;
    const cta = root.querySelector<HTMLAnchorElement>('[data-fit-cta]')!;

    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const concern = concerns[Number(button.dataset.concern)];
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        answer.hidden = false;
        answerText.textContent = concern.answer;
        cta.textContent = concern.cta;
        cta.href = `/contact?concern=${concern.id}`;
      }),
    );
  }
</script>

<style>
  .tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 32px;
  }
  .tile {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    min-height: 95px;
    padding: 25px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-tile);
    background: var(--color-soft);
    color: var(--color-navy);
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }
  .tile:hover {
    border-color: var(--color-sky-strong);
  }
  .tile[aria-pressed='true'] {
    background: var(--color-sky);
    border-color: var(--color-navy);
  }
  .no {
    font-size: var(--text-meta);
    font-weight: 700;
    color: var(--color-sky-strong);
    line-height: 2.2;
  }
  .tile[aria-pressed='true'] .no {
    color: var(--color-navy);
  }
  .answer {
    margin-top: 18px;
    padding: 25px 28px;
    background: var(--color-soft);
    border-left: 3px solid var(--color-navy);
  }
  .answer .actions {
    margin-top: 20px;
  }
  @media (max-width: 760px) {
    .tiles {
      gap: 12px;
    }
    .tile {
      flex-direction: column;
      gap: 4px;
      padding: 18px;
      font-size: var(--text-ui);
    }
    .no {
      line-height: 1.5;
    }
  }
</style>
