---
// CareBlocks: 확정 항목(코칭·주간 리포트)과 미확정 운영 항목을 구분해 보여준다.
import { care } from '../data/site';
import Pending from './Pending.astro';
import Section from './Section.astro';

const CONFIRMED = 2; // 앞의 두 항목만 확정 (CONTENT-CHECKLIST)
---

<Section
  id="care"
  tone="dark"
  eyebrow="CARE THAT PARENTS CAN SEE"
  title={['아이는 현지에.', '부모는, 소식 가까이에.']}
  copy={['현지에서는 상주 코칭으로. 한국에서는 주간 리포트로.', '떨어져 있는 동안 무엇을 확인할 수 있는지 먼저 설명합니다.']}
>
  <p class="group-label">확정된 운영</p>
  <ul class="blocks blocks--confirmed">
    {care.slice(0, CONFIRMED).map((item, i) => (
      <li>
        <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3>{item.title}</h3>
        {item.body && <p>{item.body}</p>}
        {item.pending && <Pending text={item.pending} />}
      </li>
    ))}
  </ul>
  <p class="group-label">확인 중인 운영 범위</p>
  <ul class="blocks">
    {care.slice(CONFIRMED).map((item, i) => (
      <li>
        <span class="num" aria-hidden="true">{String(CONFIRMED + i + 1).padStart(2, '0')}</span>
        <h3>{item.title}</h3>
        {item.body && <p>{item.body}</p>}
        {item.pending && <Pending text={item.pending} />}
      </li>
    ))}
  </ul>
  <div class="actions">
    <a class="btn btn--sky" href="/contact">우리 아이도 가능한지 물어보기 <span class="arrow" aria-hidden="true">→</span></a>
  </div>
</Section>

<style>
  .group-label {
    margin-top: 44px;
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-sky);
  }
  .blocks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 40px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .blocks--confirmed {
    grid-template-columns: 1fr 1fr;
  }
  li {
    padding: 25px 0;
    border-top: 1px solid #54677c;
  }
  .blocks--confirmed li {
    border-top: 2px solid var(--color-sky);
  }
  .num {
    display: block;
    margin-bottom: 8px;
    font-size: var(--text-meta);
    font-weight: 700;
    color: var(--color-sky);
  }
  .blocks--confirmed h3 {
    font-size: 1.45rem;
  }
  li p {
    margin-top: 10px;
    color: var(--color-on-dark-muted);
  }
  @media (max-width: 1000px) {
    .blocks {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 760px) {
    .blocks,
    .blocks--confirmed {
      grid-template-columns: 1fr;
    }
    .group-label {
      margin-top: 32px;
    }
  }
</style>
