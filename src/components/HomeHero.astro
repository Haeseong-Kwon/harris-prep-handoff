---
// HomeHero: 2열(카피 / 참고 사진), 모바일은 순차 스택. 사진 성격을 이미지 위에 표시한다.
const facts = [
  ['최대 10주', '학교 정규 학기 기준'],
  ['정규 수업', '현지 학생과 같은 시간표'],
  ['상주 코칭', '부모 동행 없이 진행'],
  ['주간 리포트', '부모에게 전하는 학교생활'],
] as const;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="layout">
    <div class="copy">
      <p class="eyebrow">TALKPIC × SCHOOL LIFE</p>
      <h1 id="hero-title">익힌 영어를,<br />영어만 쓰는<br /><span>교실에서.</span></h1>
      <p class="lead">호주 퀸즐랜드 사립학교 정규 수업에<br />학교 텀 기준 최대 10주 동안 함께하는 별도 과정.</p>
      <div class="actions">
        <a class="btn" href="/program">프로그램 알아보기 <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--outline" href="/contact">상담 예약</a>
      </div>
      <p class="micro">초등 4~6학년 대상 상담 · 소수 선발제</p>
    </div>
    <figure class="image">
      <img src="/assets/school-classroom.jpg" width="640" height="480" fetchpriority="high" alt="협업사 공개 학교생활 참고 사진: 교실 속 학생들" />
      <figcaption>CLASSROOM / QUEENSLAND<br />학교생활 참고 사진 · 본 과정 1기 기록이 아닙니다.</figcaption>
    </figure>
  </div>
  <dl class="facts">
    {facts.map(([value, label]) => (
      <div><dt>{label}</dt><dd>{value}</dd></div>
    ))}
  </dl>
</section>

<style>
  .hero {
    max-width: calc(var(--main-max) + var(--gutter) * 2);
    margin-inline: auto;
  }
  .layout {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 35px;
    min-height: 610px;
    padding-top: 40px;
  }
  .copy {
    align-self: center;
    padding: 50px 0 45px var(--gutter);
  }
  h1 span {
    color: var(--color-sky-strong);
  }
  .lead {
    margin-top: 25px;
    color: var(--color-muted);
  }
  .micro {
    margin-top: 20px;
    font-size: var(--text-meta);
    color: var(--color-muted);
  }
  .image {
    position: relative;
    min-height: 480px;
    overflow: hidden;
    background: var(--color-soft);
  }
  .image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 54% center;
  }
  .image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 55%, #0c2340bf);
  }
  figcaption {
    position: absolute;
    z-index: 1;
    left: 26px;
    right: 26px;
    bottom: 24px;
    color: var(--color-on-dark);
    font-size: var(--text-meta);
    line-height: 1.8;
    letter-spacing: 0.02em;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    padding: 28px var(--gutter);
    background: var(--color-soft);
  }
  .facts div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding-right: 12px;
    border-right: 1px solid #c7d9e4;
  }
  .facts div:last-child {
    border-right: 0;
  }
  dd {
    font-size: 1.2rem;
    font-weight: 600;
  }
  dt {
    font-size: var(--text-ui);
    color: var(--color-muted);
  }
  @media (max-width: 1000px) {
    .layout {
      gap: 20px;
      min-height: 530px;
    }
    .copy {
      padding-left: 30px;
    }
    .image {
      min-height: 420px;
    }
  }
  @media (max-width: 760px) {
    .layout {
      display: flex;
      flex-direction: column;
      gap: 0;
      min-height: 0;
      padding-top: 0;
    }
    .copy {
      align-self: stretch;
      padding: 40px var(--gutter);
    }
    .image {
      min-height: 330px;
    }
    .facts {
      grid-template-columns: 1fr 1fr;
      padding: 25px var(--gutter);
    }
    .facts div {
      border-right: 0;
    }
    dd {
      font-size: 1.1rem;
    }
  }
</style>
