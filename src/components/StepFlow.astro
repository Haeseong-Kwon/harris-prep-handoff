---
// 단계 흐름. 넓은 화면은 가로로 이어진 선, 좁은 화면은 세로 타임라인.
// pending 단계는 "확인 중" 표시를 붙여 확정 단계와 구분한다.
import type { Point } from '../data/content';

interface Props {
  steps: (Point & { pending?: boolean })[];
  dark?: boolean;
}
const { steps, dark = false } = Astro.props;
---

<ol class:list={['flow', { dark }]} style={`--steps: ${steps.length}`}>
  {steps.map((step, i) => (
    <li>
      <span class="dot" aria-hidden="true">{i + 1}</span>
      <h3>
        {step.title}
        {step.pending && <span class="badge">확인 중</span>}
      </h3>
      <p>{step.body}</p>
    </li>
  ))}
</ol>

<style>
  .flow {
    display: grid;
    grid-template-columns: repeat(var(--steps), 1fr);
    gap: 28px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  li {
    position: relative;
  }
  li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 19px;
    left: 48px;
    right: -20px;
    height: 1px;
    background: var(--color-line-strong);
  }
  .dark li:not(:last-child)::after {
    background: var(--color-on-dark-line);
  }
  .dot {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1.5px solid var(--color-navy);
    border-radius: 50%;
    background: var(--color-surface);
    font-size: var(--text-ui);
    font-weight: 700;
  }
  .dark .dot {
    border-color: var(--color-sky);
    background: var(--color-navy);
    color: var(--color-sky);
  }
  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
  }
  .badge {
    padding: 2px 8px;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    font-size: var(--text-meta);
    font-weight: 600;
    color: var(--color-muted);
  }
  .dark .badge {
    border-color: var(--color-on-dark-line);
    color: var(--color-on-dark-muted);
  }
  p {
    margin-top: 8px;
    font-size: var(--text-ui);
    color: var(--color-muted);
  }
  .dark p {
    color: var(--color-on-dark-muted);
  }
  @media (max-width: 760px) {
    .flow {
      grid-template-columns: 1fr;
      gap: 0;
      margin-top: 28px;
    }
    li {
      padding: 0 0 26px 58px;
    }
    .dot {
      position: absolute;
      left: 0;
      top: 0;
    }
    h3 {
      margin-top: 6px;
    }
    li:not(:last-child)::after {
      top: 44px;
      bottom: 4px;
      left: 20px;
      right: auto;
      width: 1px;
      height: auto;
    }
  }
</style>
