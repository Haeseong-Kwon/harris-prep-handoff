---
import { brand, nav } from '../data/site';

interface Props {
  consultHref: string;
}
const { consultHref } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="bar">
  <div class="inner">
    <a class="brand" href="/" aria-label={`${brand.name} 홈`}>
      <span class="name">{brand.name}</span>
      <span class="parent">{brand.parent}</span>
    </a>
    <nav aria-label="주요 메뉴">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="btn reserve" href={consultHref}>상담 예약 ↗</a>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 12px var(--gutter) 0;
  }
  .inner {
    max-width: var(--content-max);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'brand reserve' 'nav nav';
    align-items: center;
    gap: 4px 12px;
    padding: 14px 18px 6px;
    border: 1px solid var(--color-border);
    border-radius: 22px;
    background: var(--color-surface);
    box-shadow: 0 4px 15px #0c234008;
  }
  .brand {
    grid-area: brand;
    display: flex;
    flex-direction: column;
    color: var(--color-text);
    text-decoration: none;
  }
  .name {
    font-size: clamp(1.0625rem, 0.9rem + 0.6vw, 1.375rem);
    font-weight: 700;
    letter-spacing: 1px;
    line-height: 1.3;
  }
  .parent {
    font-size: var(--text-micro);
    color: var(--color-text-2);
  }
  .reserve {
    grid-area: reserve;
    border-radius: var(--radius-pill);
    padding: 10px 16px;
    min-height: var(--touch-min);
    font-size: var(--text-note);
  }
  nav {
    grid-area: nav;
    overflow-x: auto;
    scrollbar-width: none;
  }
  ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    padding: 0 10px;
    border-radius: var(--radius-button);
    color: var(--color-text-2);
    font-size: var(--text-small);
    text-decoration: none;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--color-text);
    background: var(--color-subtle);
  }
  nav a[aria-current='page'] {
    color: var(--color-accent);
    font-weight: 600;
  }
  nav li:first-child a {
    padding-left: 0;
  }
  @media (min-width: 900px) {
    .inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav reserve';
      padding: 14px 18px 14px 25px;
    }
    nav ul {
      justify-content: center;
    }
    nav li:first-child a {
      padding-left: 10px;
    }
    .reserve {
      padding: 12px 19px;
      font-size: 0.875rem;
    }
  }
</style>
