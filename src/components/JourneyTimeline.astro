---
// 04 여정 8단계. 모바일 1열·넓은 화면 2열. 준비/사후 단계는 현지 최대 10주와 구분한다.
import { journey } from '../data/site';
import Pending from './Pending.astro';
import Section from './Section.astro';
---

<Section
  id="journey"
  kicker="04 / BEFORE, DURING & AFTER"
  title={['출국 전부터 귀국 후까지.', '과정의 흐름을 먼저 봅니다.']}
  copy={['학교생활은 최대 10주. 준비와 귀국 후 단계는 별도 일정입니다.']}
>
  <ol class="steps">
    {journey.map((step, i) => (
      <li class="step">
        <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <div>
          <h3>{step.title}</h3>
          {step.body && <p>{step.body}</p>}
          {step.pending && <Pending text={step.pending} />}
        </div>
      </li>
    ))}
  </ol>
</Section>

<style>
  .steps {
    display: grid;
    gap: 12px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }
  .step {
    display: flex;
    gap: 14px;
    padding: 19px;
    border-radius: var(--radius-step);
    background: var(--color-subtle);
  }
  .num {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1.5;
  }
  h3 {
    font-size: 1rem;
  }
  p {
    margin-top: 4px;
    font-size: var(--text-small);
    color: var(--color-text-2);
  }
  .step :global(.pending) {
    margin-top: 0;
  }
  @media (min-width: 600px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
