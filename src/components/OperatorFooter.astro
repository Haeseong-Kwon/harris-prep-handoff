---
import { brand, contact, nav, photoCredits } from '../data/site';
---

<footer class="footer">
  <div class="container">
    <div class="top">
      <div>
        <p class="name">{brand.name}</p>
        <p>{brand.parent} · 운영 주체 {brand.operator}</p>
      </div>
      <nav aria-label="하단 메뉴">
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/privacy">개인정보 처리방침</a></li>
        </ul>
      </nav>
    </div>
    <p class="meta">
      전화 <a href={contact.phoneHref}>{contact.phoneDisplay}</a> · 이메일 <a href={`mailto:${contact.email}`}>{contact.email}</a>
    </p>
    <p class="meta">[자료 대기: 사업자등록번호 · 사업장 주소 · 대표자 · 개인정보 보호책임자]</p>
    <div class="credits">
      <p><strong>사진 출처 및 사용 조건</strong></p>
      {photoCredits.map((c) => (
        <p>
          {c.label}: {c.author} · {c.year} · {c.license} ·{' '}
          <a href={c.source} target="_blank" rel="noopener">원본 및 라이선스<span class="sr-only">(새 창)</span></a>
        </p>
      ))}
      <p>크기 조정 및 화면에 맞춘 크롭 적용. 대표·참가 학생·후기 사진은 실제 자료 확보 후 추가합니다.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 35px;
    background: var(--color-muted);
    font-size: var(--text-note);
    color: var(--color-text-3);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
  }
  .name {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--color-text);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    color: var(--color-text-2);
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
  }
  .meta {
    margin-top: 10px;
  }
  .credits {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-micro);
  }
  .credits p + p {
    margin-top: 4px;
  }
</style>
