---
import ComparisonTable from '../components/ComparisonTable.astro';
import ConcernDiagnosis from '../components/ConcernDiagnosis.astro';
import Journey from '../components/Journey.astro';
import KeyFacts from '../components/KeyFacts.astro';
import PageCta from '../components/PageCta.astro';
import PageNav from '../components/PageNav.astro';
import PageTitle from '../components/PageTitle.astro';
import Section from '../components/Section.astro';
import { pageHeroes, programFacts } from '../data/content';
import Base from '../layouts/Base.astro';
---

<Base title="프로그램">
  <PageTitle {...pageHeroes.program} />
  <PageNav
    items={[
      { id: 'overview', label: '한눈에 보기' },
      { id: 'compare', label: '과정의 차이' },
      { id: 'journey', label: '전체 여정' },
      { id: 'diagnosis', label: '고민 진단' },
    ]}
  />
  <Section id="overview" eyebrow="AT A GLANCE" title={['HARRIS PREP,', '한눈에 보기.']} copy={['확정된 운영 정보입니다. 세부 조건은 상담에서 함께 확인합니다.']}>
    <KeyFacts facts={programFacts} />
  </Section>
  <ComparisonTable tone="soft" />
  <Journey tone="white" />
  <ConcernDiagnosis />
  <PageCta />
</Base>
