---
import CareBlocks from '../components/CareBlocks.astro';
import PageCta from '../components/PageCta.astro';
import PageNav from '../components/PageNav.astro';
import PageTitle from '../components/PageTitle.astro';
import Section from '../components/Section.astro';
import StepFlow from '../components/StepFlow.astro';
import { careFlow, careQuestions, pageHeroes } from '../data/content';
import Base from '../layouts/Base.astro';
---

<Base title="현지 케어">
  <PageTitle {...pageHeroes.care} />
  <PageNav
    items={[
      { id: 'care-flow', label: '떨어져 있는 동안' },
      { id: 'care', label: '케어 구성' },
      { id: 'care-questions', label: '상담에서 확인할 질문' },
    ]}
  />
  <Section id="care-flow" eyebrow="WHILE YOU ARE APART" title={['출국 전부터 귀국까지,', '무엇을 확인할 수 있나요?']}>
    <StepFlow steps={careFlow} />
  </Section>
  <CareBlocks />
  <Section id="care-questions" eyebrow="QUESTIONS TO ASK" title={['신청 전,', '꼭 확인해야 할 돌봄 질문.']} copy={['아래 항목은 운영 범위를 확인하고 있습니다. 신청 전에 상담에서 함께 검토합니다.']}>
    <div class="questions">
      <ul class="checklist">
        {careQuestions.map((q) => <li>{q}</li>)}
      </ul>
      <a class="btn" href="/contact?concern=1">돌봄 범위 상담하기 <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </Section>
  <PageCta />
</Base>

<style>
  .questions {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 48px;
    align-items: end;
    margin-top: 32px;
  }
  .questions .btn {
    justify-self: start;
  }
  @media (max-width: 760px) {
    .questions {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
