---
import '../styles/global.css';
import { PUBLIC_CONSULT_ENDPOINT as CONSULT_ENDPOINT } from 'astro:env/client';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description?: string;
}

const DEFAULT_DESCRIPTION = '톡픽의 단기유학 브랜드 HARRIS PREP. 호주 사립학교 정규 수업 학교 연계 과정 안내.';
const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
const fullTitle = `${title} | HARRIS PREP`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 공개 전 검토용. 공개 검수 후 제거 (handoff README) -->
    <meta name="robots" content="noindex,nofollow" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c2340" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ko_KR" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">본문 바로가기</a>
    {!CONSULT_ENDPOINT && <p class="review">개발 검토용 · 미확정 정보는 자료 대기로 표시 · 상담 정보 전송 없음</p>}
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .review {
    padding: 8px 20px;
    background: var(--color-navy);
    color: #dbe8f0;
    font-size: var(--text-meta);
    text-align: center;
  }
</style>
