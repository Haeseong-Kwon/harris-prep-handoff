---
// 본문 구간. 흰 면 / 옅은 하늘 면 / 남색 면. 구간 사이는 구분선으로 나눈다.
interface Props {
  id?: string;
  tone?: 'white' | 'soft' | 'dark';
  eyebrow: string;
  title: string[];
  copy?: string[];
}

const { id, tone = 'white', eyebrow, title, copy } = Astro.props;
const headingId = id ? `${id}-title` : undefined;
---

<section id={id} class:list={['section', `section--${tone}`]} aria-labelledby={headingId}>
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={headingId}>{title.map((line, i) => (<>{i > 0 && <br />}{line}</>))}</h2>
    {copy && <p class="copy">{copy.map((line, i) => (<>{i > 0 && <br />}{line}</>))}</p>}
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-y);
    border-bottom: 1px solid var(--color-line);
  }
  .section--soft {
    background: var(--color-soft);
  }
  .section--dark {
    background: var(--color-navy);
    color: var(--color-on-dark);
    border-bottom: 0;
  }
  .copy {
    max-width: 720px;
    margin-top: 22px;
    color: var(--color-muted);
  }
  .section--dark .eyebrow,
  .section--dark :global(.note) {
    color: var(--color-sky);
  }
  .section--dark .copy,
  .section--dark :global(.pending summary),
  .section--dark :global(.pending p) {
    color: var(--color-on-dark-muted);
  }
  .section--dark :global(.pending p) {
    border-color: var(--color-on-dark-line);
  }
</style>
