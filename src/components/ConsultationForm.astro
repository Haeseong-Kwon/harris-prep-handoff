---
// ConsultationForm. 상담 구현 계약(docs/handoff/SPEC.md, handoff-website/DEVELOPER-SPEC.md) 기준.
// endpoint 미설정 시 제출 비활성(접수 연결 대기). JS 없이도 제출 버튼은 비활성이며 method=post라 URL에 개인정보가 남지 않는다.
import { PUBLIC_CONSULT_ENDPOINT as ENDPOINT, PUBLIC_KAKAO_CHANNEL_URL as KAKAO_URL } from 'astro:env/client';
import { contact } from '../data/site';
import { GRADES, LIMITS } from '../lib/consult';
import Section from './Section.astro';

const live = Boolean(ENDPOINT);
---

<Section
  id="consult"
  tone="dark"
  eyebrow="START WITH A CONVERSATION"
  title={['신청을 결정하기 전에,', '아이 이야기부터.']}
  copy={['참가 가능 시기와 준비 조건,', '돌봄 범위와 비용을 함께 확인합니다.']}
>
  <div class="layout">
    <aside class="channels" aria-label="연락처">
      <dl>
        <div><dt>전화</dt><dd><a href={contact.phoneHref}>{contact.phoneDisplay}</a></dd></div>
        <div><dt>이메일</dt><dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd></div>
        <div>
          <dt>카카오톡</dt>
          <dd>
            {KAKAO_URL ? (
              <a href={KAKAO_URL} target="_blank" rel="noopener">채널 상담<span class="sr-only"> 새 창</span></a>
            ) : (
              <span class="waiting">채널 연결 대기</span>
            )}
          </dd>
        </div>
        <div><dt>상담 담당</dt><dd>{contact.manager}</dd></div>
      </dl>
    </aside>

    <div class="panel">
      <form class="form" method="post" novalidate data-consult data-endpoint={ENDPOINT ?? ''}>
        <div class="field">
          <label for="consult-name">보호자 성함</label>
          <input id="consult-name" name="guardianName" class="input" autocomplete="name" maxlength={LIMITS.name} placeholder="성함" aria-describedby="consult-name-error" />
          <p class="error" id="consult-name-error" role="alert"></p>
        </div>
        <div class="field">
          <label for="consult-phone">연락처</label>
          <input id="consult-phone" name="phone" class="input" type="tel" inputmode="tel" autocomplete="tel" placeholder="010-0000-0000" aria-describedby="consult-phone-error" />
          <p class="error" id="consult-phone-error" role="alert"></p>
        </div>
        <div class="field">
          <label for="consult-grade">자녀 학년</label>
          <select id="consult-grade" name="grade" class="input" aria-describedby="consult-grade-error">
            <option value="">선택해주세요</option>
            {GRADES.map((g) => <option value={g}>초등 {g}학년</option>)}
          </select>
          <p class="error" id="consult-grade-error" role="alert"></p>
        </div>
        <div class="field field--wide">
          <label for="consult-message">상담하고 싶은 내용 <span class="optional">(선택)</span></label>
          <textarea id="consult-message" name="message" class="input" rows="3" maxlength={LIMITS.message} placeholder="희망 시기 또는 궁금한 점" aria-describedby="consult-message-error"></textarea>
          <p class="error" id="consult-message-error" role="alert"></p>
        </div>
        <div class="hp" aria-hidden="true">
          <label for="consult-company">회사</label>
          <input id="consult-company" name="company" tabindex="-1" autocomplete="off" />
        </div>

        <p class="form-note">
          [자료 대기: 수집 항목·목적·보유 기간·동의 거부 시 영향] <a href="/privacy">개인정보 처리방침</a><br />자녀 이름·생년월일은 수집하지 않습니다.
        </p>

        <fieldset class="consents">
          <legend class="sr-only">동의 항목</legend>
          <div>
            <label class="check"><input type="checkbox" name="consentPrivacy" aria-describedby="consult-privacy-error" /><span><b>[필수]</b> 개인정보 수집·이용에 동의합니다. [정책 전문 대기]</span></label>
            <p class="error" id="consult-privacy-error" role="alert"></p>
          </div>
          <div>
            <label class="check"><input type="checkbox" name="consentGuardian" aria-describedby="consult-guardian-error" /><span><b>[필수]</b> 만 14세 미만 자녀의 법정대리인으로서 자녀 정보 수집·이용에 동의합니다. [확인 절차 대기]</span></label>
            <p class="error" id="consult-guardian-error" role="alert"></p>
          </div>
          <label class="check"><input type="checkbox" name="consentMarketing" /><span>[선택] 마케팅 정보 수신에 동의합니다. [목적·항목·기간·수신 채널 대기]</span></label>
        </fieldset>

        <button class="btn submit" type="submit" disabled data-submit>{live ? '상담 신청하기' : '카카오톡 채널 상담 예약 · 연결 대기'}</button>
        <p class="status" data-status role="status">
          {!live && <>[자료 대기: 카카오톡 채널 URL · 접수 시스템]<br />검토용 버전입니다. 입력 내용은 전송·저장되지 않습니다.</>}
        </p>
      </form>
      <div class="done" data-done hidden tabindex="-1">
        <h3>상담 신청이 접수되었습니다.</h3>
        <p>남겨주신 연락처로 상담 일정을 안내드립니다.</p>
      </div>
    </div>
  </div>
</Section>

<script>
  import { concerns } from '../data/site';
  import {
    parseConcernParam,
    submitConsult,
    toPayload,
    validateConsult,
    type ConsultErrors,
    type ConsultField,
    type ConsultInput,
  } from '../lib/consult';

  // 진단에서 넘어온 고민(?concern=n)을 상담 내용에 표시. 범위 밖·자유 텍스트는 무시한다.
  const concernIndex = parseConcernParam(window.location.search, concerns.length);
  const message = document.querySelector<HTMLTextAreaElement>('#consult-message');
  if (concernIndex !== null && message && !message.value) {
    message.value = concerns[concernIndex].lines.join(' ');
  }

  const ERROR_TARGETS: Record<ConsultField, string> = {
    guardianName: 'consult-name-error',
    phone: 'consult-phone-error',
    grade: 'consult-grade-error',
    message: 'consult-message-error',
    consentPrivacy: 'consult-privacy-error',
    consentGuardian: 'consult-guardian-error',
  };
  const FAILURE = {
    network: '네트워크 연결을 확인한 뒤 다시 시도해 주세요. 입력하신 내용은 그대로 남아 있습니다.',
    server: '접수 중 문제가 발생했습니다. 잠시 후 다시 시도하거나 전화로 문의해 주세요. 입력하신 내용은 그대로 남아 있습니다.',
  } as const;

  const form = document.querySelector<HTMLFormElement>('[data-consult]');
  const endpoint = form?.dataset.endpoint;

  if (form && endpoint) {
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const done = document.querySelector<HTMLElement>('[data-done]')!;
    // 재시도해도 같은 id를 보내 서버가 중복 접수를 걸러낼 수 있게 한다.
    const submissionId = crypto.randomUUID();
    submit.disabled = false;

    const read = (): ConsultInput => {
      const data = new FormData(form);
      const text = (key: string) => String(data.get(key) ?? '');
      return {
        guardianName: text('guardianName'),
        phone: text('phone'),
        grade: text('grade'),
        message: text('message'),
        consentPrivacy: data.has('consentPrivacy'),
        consentGuardian: data.has('consentGuardian'),
        consentMarketing: data.has('consentMarketing'),
      };
    };

    const showErrors = (errors: ConsultErrors) => {
      (Object.keys(ERROR_TARGETS) as ConsultField[]).forEach((field) => {
        const target = document.getElementById(ERROR_TARGETS[field])!;
        const control = form.querySelector<HTMLElement>(`[aria-describedby="${ERROR_TARGETS[field]}"]`)!;
        target.textContent = errors[field] ?? '';
        control.toggleAttribute('aria-invalid', Boolean(errors[field]));
      });
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submit.disabled) return;
      // 봇이 채우는 숨김 필드. 채워져 있으면 조용히 무시한다.
      if (new FormData(form).get('company')) return;

      const input = read();
      const errors = validateConsult(input);
      showErrors(errors);
      const firstInvalid = form.querySelector<HTMLElement>('[aria-invalid]');
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      submit.disabled = true;
      submit.textContent = '접수 중…';
      form.setAttribute('aria-busy', 'true');
      status.textContent = '';

      const result = await submitConsult(endpoint, toPayload(input, submissionId));

      form.removeAttribute('aria-busy');
      if (result.ok) {
        form.hidden = true;
        done.hidden = false;
        done.focus();
        return;
      }
      submit.disabled = false;
      submit.textContent = '다시 시도하기';
      status.textContent = FAILURE[result.reason];
      status.setAttribute('role', 'alert');
    });
  }
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1fr 1.7fr;
    gap: 48px;
    align-items: start;
    margin-top: 40px;
  }
  .channels div {
    padding: 16px 0;
    border-top: 1px solid var(--color-on-dark-line);
  }
  .channels div:first-child {
    border-top: 2px solid var(--color-sky);
  }
  dt {
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-sky);
  }
  dd {
    margin-top: 2px;
    font-size: 1.1rem;
    overflow-wrap: anywhere;
  }
  dd a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    text-decoration: underline;
    text-decoration-color: #7790a8;
    text-underline-offset: 6px;
  }
  dd a:hover {
    text-decoration-color: var(--color-sky);
  }
  .waiting {
    color: var(--color-on-dark-muted);
  }
  .panel {
    padding: 32px;
    border-radius: var(--radius-tile);
    background: var(--color-surface);
    color: var(--color-navy);
  }
  .form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .field--wide,
  .form-note,
  .consents,
  .submit,
  .status {
    grid-column: 1 / -1;
  }
  .field label {
    display: block;
    font-size: var(--text-ui);
    font-weight: 600;
  }
  .optional {
    font-weight: 400;
    color: var(--color-muted);
  }
  .input {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 48px;
    margin-top: 8px;
    padding: 12px 14px;
    border: 1px solid var(--color-line-strong);
    border-radius: 3px;
    background: var(--color-field);
    color: var(--color-navy);
    font-size: 1rem; /* iOS 자동 확대 방지 */
    transition: border-color var(--duration) var(--ease);
  }
  .input:hover {
    border-color: var(--color-muted);
  }
  .input:focus-visible {
    outline-offset: 0;
    border-color: var(--color-navy);
  }
  textarea.input {
    resize: vertical;
  }
  .input::placeholder {
    color: #6f8295;
  }
  .input[aria-invalid] {
    border-color: var(--color-error);
  }
  .error {
    margin-top: 4px;
    font-size: var(--text-meta);
    color: var(--color-error);
  }
  .form-note {
    font-size: var(--text-ui);
    color: var(--color-muted);
  }
  .form-note a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .consents {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 16px 0 0;
    border: 0;
    border-top: 1px solid var(--color-line);
  }
  .check {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    min-height: var(--touch-min);
    font-size: var(--text-ui);
    color: var(--color-muted);
    cursor: pointer;
  }
  .check input {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin: 3px 0 0;
    accent-color: var(--color-navy);
  }
  .check b {
    color: var(--color-navy);
  }
  .check:has(input[aria-invalid]) {
    color: var(--color-error);
  }
  .submit {
    width: 100%;
  }
  .status {
    font-size: var(--text-ui);
    color: var(--color-muted);
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .done {
    padding: 12px 0;
  }
  .done p {
    margin-top: 8px;
    color: var(--color-muted);
  }
  @media (max-width: 1000px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .channels dl {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 24px;
    }
    .channels div:nth-child(2) {
      border-top: 2px solid var(--color-sky);
    }
  }
  @media (max-width: 760px) {
    .channels dl {
      grid-template-columns: 1fr;
    }
    .channels div:nth-child(2) {
      border-top: 1px solid var(--color-on-dark-line);
    }
    .panel {
      padding: 22px;
    }
    .form {
      grid-template-columns: 1fr;
    }
  }
</style>
