---
import CohortRecord from '../components/CohortRecord.astro';
import PageCta from '../components/PageCta.astro';
import PageNav from '../components/PageNav.astro';
import PageTitle from '../components/PageTitle.astro';
import PartnerCard from '../components/PartnerCard.astro';
import PointsGrid from '../components/PointsGrid.astro';
import RepresentativeProfile from '../components/RepresentativeProfile.astro';
import Section from '../components/Section.astro';
import { brandStructure, pageHeroes, principles } from '../data/content';
import Base from '../layouts/Base.astro';
---

<Base title="브랜드 소개">
  <PageTitle {...pageHeroes.about} />
  <PageNav
    items={[
      { id: 'brand', label: '브랜드' },
      { id: 'people', label: '운영진' },
      { id: 'principles', label: '정보 공개 원칙' },
      { id: 'cohort', label: '1기 기록' },
      { id: 'partner', label: '현지 파트너' },
    ]}
  />
  <Section id="brand" tone="soft" eyebrow="FROM TALKPIC TO HARRIS PREP" title={['집에서 시작하고,', '세계에서 이어갑니다.']}>
    <ol class="structure">
      {brandStructure.map((b) => (
        <li>
          <p class="label">{b.label}</p>
          <h3>{b.title}</h3>
          <p class="body">{b.body}</p>
        </li>
      ))}
    </ol>
  </Section>
  <RepresentativeProfile />
  <Section id="principles" tone="dark" eyebrow="OUR PRINCIPLES" title={['아이를 맡기는 결정이기에,', '정보부터 정직하게.']}>
    <PointsGrid items={principles} columns={4} dark />
  </Section>
  <CohortRecord />
  <PartnerCard />
  <PageCta />
</Base>

<style>
  .structure {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }
  .structure li {
    position: relative;
    padding: 32px 40px 32px 0;
    border-top: 2px solid var(--color-navy);
  }
  .structure li + li {
    padding-left: 40px;
    border-left: 1px solid var(--color-line-strong);
  }
  .structure li:first-child::after {
    content: '→';
    position: absolute;
    right: -14px;
    top: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-navy);
    color: var(--color-sky);
    font-size: var(--text-ui);
    transform: translateY(-50%);
  }
  .label {
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-sky-strong);
  }
  .structure h3 {
    margin-top: 12px;
    font-size: 1.6rem;
    letter-spacing: -0.04em;
  }
  .body {
    margin-top: 10px;
    color: var(--color-muted);
  }
  @media (max-width: 760px) {
    .structure {
      grid-template-columns: 1fr;
    }
    .structure li,
    .structure li + li {
      padding: 24px 0;
      border-left: 0;
    }
    .structure li:first-child::after {
      content: '↓';
      top: auto;
      right: auto;
      left: 0;
      bottom: -14px;
      transform: none;
    }
  }
</style>
