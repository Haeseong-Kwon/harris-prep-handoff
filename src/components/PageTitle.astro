---
// 하위 페이지 제목 띠. 페이지당 h1 하나, 출처 없는 평가·랭킹 금지.
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<div class="page-title">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
  </div>
</div>

<style>
  .page-title {
    padding-block: 72px 60px;
    background: var(--color-soft);
    border-bottom: 1px solid var(--color-line);
  }
  h1 {
    font-size: var(--text-h1-page);
  }
  .lead {
    max-width: 750px;
    margin-top: 24px;
    color: var(--color-muted);
  }
  @media (max-width: 760px) {
    .page-title {
      padding-block: 44px 40px;
    }
  }
</style>
