---
import CareSystem from '../components/CareSystem.astro';
import CohortRecord from '../components/CohortRecord.astro';
import Consultation from '../components/Consultation.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import LocalPartner from '../components/LocalPartner.astro';
import PageIntro from '../components/PageIntro.astro';
import RepresentativeProfile from '../components/RepresentativeProfile.astro';
import Base from '../layouts/Base.astro';
---

<Base title="돌봄·운영" description="현지 상주 코칭과 주간 리포트, 운영하는 사람, 1기 기록과 현지 협업 파트너를 안내합니다.">
  <PageIntro kicker="CARE & PEOPLE" title={['떨어져 있는 동안,', '무엇을 확인할 수 있나요?']} copy="부모 동행 없이, 현지 상주 코칭과 주간 리포트로 함께합니다." />
  <CareSystem />
  <RepresentativeProfile />
  <CohortRecord />
  <LocalPartner />
  <FAQAccordion tone="muted" kicker="FAQ / CARE" title={['돌봄에 대해', '자주 묻는 질문']} topics={['care', 'safety']} />
  <Consultation />
</Base>
