---
// 비용. 3,900만 원은 예정 금액 — 확정처럼 표기하지 않는다.
import { payment } from '../data/site';
import Section from './Section.astro';
---

<Section id="cost" eyebrow="COST & PAYMENT" title={['큰 결정일수록,', '비용부터 펼쳐놓겠습니다.']}>
  <div class="layout">
    <div>
      <p class="price">{payment.price} <small>(예정)</small></p>
      <p class="note">{payment.priceNote[0]}<br />{payment.priceNote[1]}</p>
      <div class="actions">
        <a class="btn" href="/contact">납부 구조 상담 <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
    <dl class="list">
      {payment.rows.map(([label, value]) => (
        <div><dt>{label}</dt><dd class:list={{ waiting: value.startsWith('[') }}>{value}</dd></div>
      ))}
    </dl>
  </div>
</Section>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 60px;
    align-items: start;
    margin-top: 32px;
  }
  .price {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  small {
    font-size: 1.1rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-muted);
  }
  .list {
    border-top: 2px solid var(--color-navy);
  }
  .list div {
    display: flex;
    justify-content: space-between;
    gap: 25px;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-line);
  }
  dt {
    color: var(--color-muted);
  }
  dd {
    font-weight: 600;
    text-align: right;
  }
  .waiting {
    font-weight: 400;
    color: var(--color-muted);
  }
  @media (max-width: 1000px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  @media (max-width: 760px) {
    .list div {
      gap: 15px;
      font-size: var(--text-ui);
    }
  }
</style>
