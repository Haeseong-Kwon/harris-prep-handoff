---
import PageCta from '../components/PageCta.astro';
import PageNav from '../components/PageNav.astro';
import PageTitle from '../components/PageTitle.astro';
import SchoolProfile from '../components/SchoolProfile.astro';
import { pageHeroes } from '../data/content';
import Base from '../layouts/Base.astro';
---

<Base title="학교">
  <PageTitle {...pageHeroes.school} />
  <PageNav
    items={[
      { id: 'school', label: '학교 소개' },
      { id: 'same', label: '현지 학생과 같은 것' },
      { id: 'school-pending', label: '확인 중인 정보' },
    ]}
  />
  <SchoolProfile />
  <PageCta />
</Base>
