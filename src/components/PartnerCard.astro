---
// PartnerCard: 브랜드 소개 페이지 하단 한 곳에만 배치. 운영 주체로 오독되지 않게 "협업 파트너"로 표기.
import { partner } from '../data/site';
import Pending from './Pending.astro';
import Section from './Section.astro';
---

<Section id="partner" eyebrow="LOCAL PARTNER" title={['함께하는 현지 파트너']}>
  <article class="card">
    <img class="logo" src={partner.logo} width="806" height="118" loading="lazy" alt={`${partner.name} 로고`} />
    <h3>{partner.name}</h3>
    <p class="body">{partner.body[0]}<br />{partner.body[1]}</p>
    <p class="note">{partner.role}</p>
    <Pending text={partner.pending} />
  </article>
</Section>

<style>
  .card {
    max-width: 560px;
    margin-top: 32px;
    padding: 32px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-tile);
  }
  .logo {
    width: 160px;
    height: auto;
    margin-bottom: 24px;
  }
  .body {
    margin-top: 14px;
    font-size: var(--text-ui);
    color: var(--color-muted);
  }
  @media (max-width: 760px) {
    .card {
      padding: 25px;
    }
  }
</style>
