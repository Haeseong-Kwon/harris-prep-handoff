---
import FAQAccordion from '../components/FAQAccordion.astro';
import PageCta from '../components/PageCta.astro';
import PageNav from '../components/PageNav.astro';
import PageTitle from '../components/PageTitle.astro';
import PaymentStructure from '../components/PaymentStructure.astro';
import Section from '../components/Section.astro';
import StepFlow from '../components/StepFlow.astro';
import { costQuestions, paymentFlow } from '../data/content';
import Base from '../layouts/Base.astro';
---

<Base title="비용·FAQ">
  <PageTitle eyebrow="COST & FAQ" title="결정 전에 확인할 정보." lead="예정 비용과 납부 구조, 참가 전 자주 묻는 질문을 모았습니다." />
  <PageNav
    items={[
      { id: 'cost', label: '예정 비용' },
      { id: 'payment-flow', label: '납부 흐름' },
      { id: 'cost-questions', label: '비용 확인 질문' },
      { id: 'faq', label: '자주 묻는 질문' },
    ]}
  />
  <PaymentStructure />
  <Section id="payment-flow" tone="soft" eyebrow="PAYMENT FLOW" title={['상담부터 납부까지,', '순서대로 안내합니다.']}>
    <StepFlow steps={paymentFlow} />
  </Section>
  <Section id="cost-questions" eyebrow="BEFORE YOU PAY" title={['납부 전에', '꼭 확인할 비용 항목.']} copy={['아래 항목은 확인 중입니다. 신청·납부 전에 서면 규정을 확인해 주세요.']}>
    <ul class="checklist">
      {costQuestions.map((q) => <li>{q}</li>)}
    </ul>
  </Section>
  <FAQAccordion />
  <PageCta />
</Base>

<style>
  .checklist {
    max-width: 760px;
    margin-top: 32px;
  }
</style>
