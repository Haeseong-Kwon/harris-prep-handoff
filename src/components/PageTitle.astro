---
// 하위 페이지 히어로. 페이지당 h1 하나, 출처 없는 평가·랭킹 금지.
// 왼쪽: 현재 위치 · 소제목 · 제목 · 리드 · 핵심 사실 칩. 오른쪽(선택): 사진 / 요약 카드 / 브랜드 락업.
// 배경: 옅은 하늘 면 + 가는 격자 + 하늘색 빛 + 외곽선 페이지 번호 (모두 장식, aria-hidden).
import type { PageHero } from '../data/content';
import { brand } from '../data/site';

type Props = Partial<Pick<PageHero, 'index' | 'crumb' | 'chips' | 'aside'>> & Pick<PageHero, 'eyebrow' | 'title' | 'lead'>;

const { index, crumb, eyebrow, title, lead, chips, aside } = Astro.props;
---

<section class:list={['hero', { 'has-aside': aside }]} aria-labelledby="page-hero-title">
  <div class="bg" aria-hidden="true"></div>
  {index && <span class="index" aria-hidden="true">{index}</span>}

  <div class="container inner">
    <div class="text">
      {crumb && (
        <nav class="crumb" aria-label="현재 위치">
          <ol>
            <li><a href="/">홈</a></li>
            <li aria-current="page">{crumb}</li>
          </ol>
        </nav>
      )}
      <p class="eyebrow">{index && <span class="idx">{index}</span>}{eyebrow}</p>
      <h1 id="page-hero-title">{title}</h1>
      <p class="lead">{lead}</p>
      {chips && (
        <ul class="chips" aria-label="핵심 정보">
          {chips.map((chip) => <li>{chip}</li>)}
        </ul>
      )}
    </div>

    {aside?.kind === 'photo' && (
      <figure class="aside photo">
        <div class="frame">
          <img src={aside.src} width={aside.width} height={aside.height} alt={aside.alt} fetchpriority="high" style={aside.position ? `object-position: ${aside.position}` : undefined} />
        </div>
        <figcaption>{aside.caption}</figcaption>
      </figure>
    )}

    {aside?.kind === 'card' && (
      <div class="aside card">
        <p class="card-label">{aside.label}</p>
        <dl>
          {aside.rows.map(([label, value, href]) => (
            <div>
              <dt>{label}</dt>
              <dd>{href ? <a href={href}>{value}</a> : value}</dd>
            </div>
          ))}
        </dl>
        {aside.note && <p class="card-note">{aside.note}</p>}
        {aside.link && (
          <a class="card-link" href={aside.link.href}>{aside.link.label} <span class="arrow" aria-hidden="true">→</span></a>
        )}
      </div>
    )}

    {aside?.kind === 'lockup' && (
      <div class="aside card lockup">
        <p class="card-label">BRAND</p>
        <p class="from">TALKPIC</p>
        <span class="line" aria-hidden="true"></span>
        <p class="to">{brand.name}</p>
        <p class="card-note">{brand.parent} · 운영 주체 {brand.operator}</p>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-soft);
    border-bottom: 1px solid var(--color-line);
  }
  .bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(55% 90% at 88% 10%, rgb(184 212 232 / 0.75), transparent 70%),
      radial-gradient(40% 60% at 0% 100%, rgb(255 255 255 / 0.7), transparent 70%),
      linear-gradient(to right, rgb(12 35 64 / 0.055) 1px, transparent 1px) 0 0 / 64px 64px,
      linear-gradient(to bottom, rgb(12 35 64 / 0.055) 1px, transparent 1px) 0 0 / 64px 64px;
    mask-image: linear-gradient(to bottom, #000 55%, rgb(0 0 0 / 0.35));
  }
  .index {
    position: absolute;
    left: max(var(--gutter), calc((100% - var(--main-max)) / 2));
    bottom: -0.22em;
    z-index: -1;
    font-size: clamp(9rem, 4rem + 16vw, 20rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(70 109 138 / 0.22);
    pointer-events: none;
    user-select: none;
  }
  .inner {
    display: grid;
    gap: 56px;
    align-items: center;
    padding-block: 56px 72px;
  }
  .has-aside .inner {
    grid-template-columns: 1.05fr 0.95fr;
  }

  /* 현재 위치 */
  .crumb ol {
    display: flex;
    flex-wrap: wrap;
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
    font-size: var(--text-meta);
    color: var(--color-muted);
  }
  .crumb li + li::before {
    content: '/';
    margin: 0 10px;
    color: var(--color-line-strong);
  }
  .crumb a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .crumb a:hover {
    color: var(--color-navy);
  }
  .crumb [aria-current] {
    font-weight: 600;
    color: var(--color-navy);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .idx {
    padding-right: 12px;
    border-right: 1px solid var(--color-line-strong);
    color: var(--color-sky-strong);
  }
  h1 {
    font-size: var(--text-h1-page);
    text-wrap: balance;
  }
  .lead {
    max-width: 560px;
    margin-top: 22px;
    color: var(--color-muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .chips li {
    padding: 6px 14px;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.7);
    font-size: var(--text-ui);
    font-weight: 600;
  }

  /* 오른쪽: 공통 — 뒤에 하늘색 면을 어긋나게 깔아 깊이를 준다 */
  .aside {
    position: relative;
    margin: 0;
  }
  .frame,
  .card {
    position: relative;
  }
  .frame::before,
  .card::before {
    content: '';
    position: absolute;
    inset: 18px -18px -18px 18px;
    z-index: -1;
    background: var(--color-sky);
  }
  .frame img {
    width: 100%;
    height: 360px;
    object-fit: cover;
    box-shadow: 0 24px 48px #0c234022;
  }
  .photo figcaption {
    margin-top: 28px;
    font-size: var(--text-meta);
    color: var(--color-muted);
  }

  .card {
    padding: 32px;
    background: var(--color-navy);
    color: var(--color-on-dark);
    box-shadow: 0 24px 48px #0c234029;
  }
  .card-label {
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-sky);
  }
  dl {
    margin-top: 18px;
    border-top: 1px solid var(--color-on-dark-line);
  }
  dl div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-on-dark-line);
  }
  dt {
    color: var(--color-on-dark-muted);
  }
  dd {
    font-weight: 600;
    text-align: right;
    overflow-wrap: anywhere;
  }
  dd a {
    text-decoration: underline;
    text-decoration-color: #7790a8;
    text-underline-offset: 4px;
  }
  dd a:hover {
    text-decoration-color: var(--color-sky);
  }
  .card-note {
    margin-top: 16px;
    font-size: var(--text-ui);
    color: var(--color-on-dark-muted);
  }
  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--touch-min);
    margin-top: 8px;
    color: var(--color-sky);
    font-size: var(--text-ui);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .card-link .arrow {
    transition: transform var(--duration) var(--ease);
  }
  .card-link:hover .arrow {
    transform: translateX(4px);
  }

  /* 브랜드 락업 */
  .lockup .from {
    margin-top: 28px;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-on-dark-muted);
  }
  .lockup .line {
    position: relative;
    display: block;
    width: 1px;
    height: 44px;
    margin: 10px 0 10px 6px;
    background: var(--color-sky);
  }
  .lockup .line::after {
    content: '';
    position: absolute;
    left: -4px;
    bottom: 0;
    width: 7px;
    height: 7px;
    border-right: 1px solid var(--color-sky);
    border-bottom: 1px solid var(--color-sky);
    transform: rotate(45deg);
  }
  .lockup .to {
    font-size: clamp(2rem, 1.4rem + 2vw, 2.8rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.2;
  }

  /* 등장 — 움직임 허용일 때만 */
  @media (prefers-reduced-motion: no-preference) {
    .text > *,
    .aside {
      animation: hero-in 700ms var(--ease) both;
    }
    .text > :nth-child(2) {
      animation-delay: 60ms;
    }
    .text > :nth-child(3) {
      animation-delay: 120ms;
    }
    .text > :nth-child(4) {
      animation-delay: 180ms;
    }
    .text > :nth-child(5) {
      animation-delay: 240ms;
    }
    .aside {
      animation-delay: 200ms;
    }
    .index {
      animation: hero-index 1200ms var(--ease) both;
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @keyframes hero-index {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }

  @media (max-width: 1000px) {
    .has-aside .inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .aside {
      max-width: 560px;
    }
    .index {
      left: auto;
      right: var(--gutter);
      bottom: auto;
      top: 8px;
      font-size: clamp(7rem, 4rem + 12vw, 12rem);
    }
  }
  @media (max-width: 760px) {
    .inner {
      padding-block: 32px 56px;
    }
    .crumb ol {
      margin-bottom: 20px;
    }
    .frame img {
      height: 230px;
    }
    .frame::before,
    .card::before {
      inset: 12px -10px -12px 12px;
    }
    .card {
      padding: 24px;
    }
    .aside {
      margin-right: 10px;
    }
  }
</style>
