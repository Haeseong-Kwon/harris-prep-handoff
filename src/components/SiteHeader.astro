---
// SiteHeader. 넓은 화면은 가로 메뉴 + 전체 메뉴 버튼, 1000px 이하는 전체 메뉴 버튼만.
// 스크롤하면 그림자를 진하게 해 본문과 구분한다.
import { brand, nav } from '../data/site';
import MenuDrawer from './MenuDrawer.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header" data-header>
  <div class="inner">
    <a class="wordmark" href="/">
      <strong>{brand.name}</strong>
      <span>{brand.parent}</span>
    </a>
    <nav class="inline-nav" aria-label="주 메뉴">
      <ul>
        {nav.map((item) => (
          <li><a class="nav-link" href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="tools">
      <a class="btn reserve" href="/contact" aria-current={path === '/contact' ? 'page' : undefined}>상담 예약</a>
      <button class="menu-toggle" type="button" aria-haspopup="dialog" aria-controls="menu-drawer" aria-expanded="false" data-menu-open>
        <span class="bars" aria-hidden="true"><span></span></span>
        <span>메뉴</span>
      </button>
    </div>
  </div>
</header>
<MenuDrawer path={path} />

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  let ticking = false;
  const update = () => {
    header?.toggleAttribute('data-scrolled', window.scrollY > 8);
    ticking = false;
  };
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    },
    { passive: true },
  );
  update();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.96);
    backdrop-filter: saturate(1.4) blur(10px);
    box-shadow: 0 1px 0 var(--color-line);
    transition: box-shadow var(--duration) var(--ease);
  }
  .site-header[data-scrolled] {
    box-shadow:
      0 1px 0 var(--color-line),
      0 10px 30px #0c234014;
  }
  .inner {
    max-width: var(--header-max);
    height: var(--header-h);
    margin-inline: auto;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    gap: 30px;
  }
  .wordmark {
    display: grid;
    flex-shrink: 0;
    margin-right: auto;
    line-height: 1.45;
  }
  .wordmark strong {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.075em;
  }
  .wordmark span {
    font-size: var(--text-meta);
    color: var(--color-muted);
  }
  ul {
    display: flex;
    gap: 26px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-ui);
    white-space: nowrap;
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 2px;
    background: var(--color-navy);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration) var(--ease);
  }
  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }
  .nav-link[aria-current='page'] {
    font-weight: 700;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .reserve {
    min-height: var(--touch-min);
    padding: 10px 20px;
  }
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--touch-min);
    padding: 0 14px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-ui);
    background: var(--color-surface);
    color: var(--color-navy);
    font-size: var(--text-ui);
    cursor: pointer;
    transition: border-color var(--duration) var(--ease);
  }
  .menu-toggle:hover {
    border-color: var(--color-navy);
  }
  .bars {
    display: grid;
    gap: 4px;
    width: 16px;
  }
  .bars::before,
  .bars::after,
  .bars span {
    content: '';
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--duration) var(--ease);
  }
  .bars span {
    width: 70%;
    margin-left: auto;
  }
  .menu-toggle:hover .bars span {
    transform: scaleX(1.43);
    transform-origin: right;
  }
  @media (max-width: 1000px) {
    .inline-nav {
      display: none;
    }
    .wordmark strong {
      font-size: 1.25rem;
    }
    .inner {
      gap: 16px;
    }
  }
  @media (max-width: 480px) {
    .reserve {
      display: none;
    }
  }
</style>
