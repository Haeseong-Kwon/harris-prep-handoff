---
// FAQ 8개. native details/summary, 여러 개 동시에 열 수 있다.
import { faqs } from '../data/site';
import Section from './Section.astro';
---

<Section id="faq" tone="soft" eyebrow="QUESTIONS BEFORE YOU DECIDE" title={['신청 전,', '먼저 확인하세요.']}>
  <div class="list">
    {faqs.map((f, i) => (
      <details>
        <summary><span class="no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span class="q">{f.q}</span></summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</Section>

<style>
  .list {
    margin-top: 32px;
    border-top: 2px solid var(--color-navy);
  }
  details {
    border-bottom: 1px solid var(--color-line-strong);
  }
  summary {
    position: relative;
    display: flex;
    gap: 18px;
    align-items: center;
    min-height: 64px;
    padding: 14px 44px 14px 0;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::before,
  summary::after {
    content: '';
    position: absolute;
    right: 8px;
    top: 50%;
    width: 14px;
    height: 1.5px;
    background: var(--color-navy);
    transition: transform var(--duration) var(--ease);
  }
  summary::after {
    transform: rotate(90deg);
  }
  details[open] summary::after {
    transform: rotate(0deg);
  }
  summary:hover .q {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .no {
    font-size: var(--text-meta);
    font-weight: 700;
    color: var(--color-sky-strong);
  }
  p {
    padding: 0 0 22px 38px;
    color: var(--color-muted);
  }
  @media (max-width: 760px) {
    summary {
      gap: 12px;
    }
    p {
      padding-left: 0;
    }
  }
</style>
