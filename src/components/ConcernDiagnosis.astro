---
// 02 고민 진단. 단일 선택 → 답변 1개 + 맞춤 CTA. 선택만으로 접수·외부 요청 없음.
import { concerns } from '../data/site';
import Section from './Section.astro';
---

<Section
  id="diagnosis"
  kicker="02 / YOUR CHILD, YOUR QUESTION"
  title={['우리 아이 영어,', '어디에서 멈춰 있나요?']}
  copy={['우리 아이에게 맞는 과정인지, 고민부터 짚어보세요.']}
>
  <div class="diagnosis" data-diagnosis>
    <div class="cards" role="group" aria-label="자녀 영어 고민 선택">
      {concerns.map((c) => (
        <button type="button" class="card-btn" data-concern={c.id} aria-pressed="false">
          {c.lines[0]}<br />{c.lines[1]}
        </button>
      ))}
    </div>
    <div aria-live="polite">
      <div class="answer" data-answer hidden>
        <p data-answer-text></p>
        <div class="actions">
          <a class="btn" href="#consult" data-fit-cta>우리 아이 과정 상담</a>
        </div>
      </div>
    </div>
  </div>
</Section>

<script>
  import { concerns } from '../data/site';
  import { nextConcernMessage } from '../lib/consult';

  const root = document.querySelector<HTMLElement>('[data-diagnosis]');
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-concern]')];
    const answer = root.querySelector<HTMLElement>('[data-answer]')!;
    const answerText = root.querySelector<HTMLElement>('[data-answer-text]')!;
    const cta = root.querySelector<HTMLElement>('[data-fit-cta]')!;
    let lastAutofill: string | null = null;

    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const concern = concerns[Number(button.dataset.concern)];
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        answer.hidden = false;
        answerText.textContent = concern.answer;
        cta.textContent = concern.cta;

        const field = document.querySelector<HTMLTextAreaElement>('#consult-message');
        if (!field) return;
        const next = nextConcernMessage(field.value, lastAutofill, concern.lines.join(' '));
        if (next !== null) {
          field.value = next;
          lastAutofill = next;
        }
      }),
    );
  }
</script>

<style>
  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 26px;
  }
  .card-btn {
    position: relative;
    min-height: 115px;
    padding: 17px 29px 17px 14px;
    border: 1px solid transparent;
    border-radius: var(--radius-card);
    background: var(--color-subtle);
    color: var(--color-text);
    font-size: var(--text-small);
    font-weight: 500;
    text-align: left;
    cursor: pointer;
  }
  .card-btn::after {
    content: '+';
    position: absolute;
    top: 15px;
    right: 14px;
    font-size: 22px;
    line-height: 1;
    color: var(--color-accent);
  }
  .card-btn:hover {
    border-color: var(--color-border-strong);
  }
  .card-btn[aria-pressed='true'] {
    background: var(--color-tint);
    border-color: var(--color-accent);
  }
  .card-btn[aria-pressed='true']::after {
    content: '✓';
    font-size: 18px;
  }
  .answer {
    margin-top: 15px;
    padding: 24px;
    border-radius: var(--radius-card);
    background: var(--color-tint);
  }
  .answer .actions {
    margin-top: 20px;
  }
  @media (min-width: 481px) {
    .cards {
      gap: 12px;
    }
    .card-btn {
      padding: 20px 35px 20px 18px;
      font-size: 0.875rem;
    }
  }
  @media (min-width: 960px) {
    .cards {
      grid-template-columns: repeat(4, 1fr);
    }
    .answer {
      max-width: 760px;
      margin-inline: auto;
      text-align: center;
    }
    .answer .actions {
      justify-content: center;
    }
  }
</style>
