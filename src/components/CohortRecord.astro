---
// 1기 기록. 스톡·협업사 사진을 실제 참가 기록으로 사용하지 않는다.
import Pending from './Pending.astro';
import Section from './Section.astro';
---

<Section id="cohort" tone="soft" eyebrow="THE FIRST COHORT" title={['첫 과정은 마쳤습니다.', '기록은 확인되는 대로 공개합니다.']}>
  <div class="layout">
    <dl class="stats">
      <div><dt>1기 파일럿 프로그램 완료</dt><dd>3명</dd></div>
      <div><dt>귀국생 성과</dt><dd class="pending-value">1기 귀국생 성과 공개 예정</dd></div>
    </dl>
    <div class="photo-slot">
      <span>[실사 촬영 필요: 1기 활동 기록]</span>
      <small>학생·보호자 공개 동의 확인 후 사용</small>
    </div>
  </div>
  <p class="note">[후기 수집 중]</p>
  <Pending text="[검증 필요: 귀국 후 성과 증빙·공개 동의]" />
</Section>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 40px;
    margin-top: 36px;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: 22px 0;
    border-top: 1px solid var(--color-line-strong);
  }
  .stats div:first-child {
    border-top: 2px solid var(--color-navy);
  }
  dd {
    font-size: 2.3rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.3;
  }
  .pending-value {
    font-size: 1.1rem;
  }
  dt {
    color: var(--color-muted);
  }
  .photo-slot {
    background: var(--color-surface);
  }
  @media (max-width: 760px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    dd {
      font-size: 1.75rem;
    }
  }
</style>
